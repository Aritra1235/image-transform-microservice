# Direct HTTP origin for ORIGINAL objects. Do not point this at the public CDN
# after the CDN itself starts using this transformer as its origin.
SOURCE_ORIGIN=https://your-direct-object-storage-origin.example.com

PORT=8080
DEFAULT_JPEG_COMPRESSION=82
DEFAULT_WEBP_COMPRESSION=80
DEFAULT_PNG_COMPRESSION=70
DEFAULT_FIT=cover

# Request/output safety limits.
MAX_WIDTH=5000
MAX_HEIGHT=5000
MAX_PIXELS=25000000
MAX_SOURCE_PIXELS=50000000
MAX_SOURCE_BYTES=26214400
FETCH_TIMEOUT_MS=10000
MAX_CONCURRENT_TRANSFORMS=1

# Keep existing non-transformed URLs working after placing this service in front
# of the origin. Set false if your CDN routes original URLs directly to S3.
PASSTHROUGH_ORIGINALS=true

CACHE_CONTROL=public, max-age=31536000, immutable
CDN_CACHE_CONTROL=public, max-age=31536000, immutable
USER_AGENT=aritra-image-transform/1.0
